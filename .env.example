# PharmaTrace / InfoSecProj Environment Configuration
# Core platform runs locally for 0 cost with zero required paid API keys.

# Host and Port Configuration
PORT=8001
HOST=0.0.0.0

# Local EVM RPC URL (Hardhat standalone node running on port 8546)
RPC_URL=http://127.0.0.1:8546

# Local SQLite Database (Async SQLAlchemy + aiosqlite)
DB_URL=sqlite+aiosqlite:///./data/infosecproj.db

# Contracts Deployment Metadata File
DEPLOYMENTS_FILE=contracts/deployments/local.json

# Optional Gemini AI API Key (Leave empty to use deterministic offline regulatory generator)
GEMINI_API_KEY=

# Hardhat Local EVM Pre-Funded Test Node Keys (Public test accounts for local simulation)
MANUFACTURER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
